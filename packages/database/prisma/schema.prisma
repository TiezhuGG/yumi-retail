generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model ValidationStock {
  id           String                  @id @db.Uuid
  label        String
  onHand       Int                     @map("on_hand")
  reserved     Int                     @default(0)
  version      Int                     @default(0)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservations ValidationReservation[]
  ledger       ValidationLedger[]

  @@map("validation_stock")
}

model ValidationReservation {
  id         String          @id @db.Uuid
  requestKey String          @unique @map("request_key")
  stockId    String          @map("stock_id") @db.Uuid
  quantity   Int
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  stock      ValidationStock @relation(fields: [stockId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([stockId], map: "validation_reservation_stock_idx")
  @@map("validation_reservation")
}

model ValidationLedger {
  id            String          @id @db.Uuid
  actionKey     String          @unique @map("action_key")
  stockId       String          @map("stock_id") @db.Uuid
  deltaReserved Int             @map("delta_reserved")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  stock         ValidationStock @relation(fields: [stockId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([stockId], map: "validation_ledger_stock_idx")
  @@map("validation_ledger")
}

model Warehouse {
  id          String              @id @db.Uuid
  code        String              @unique
  name        String
  enabled     Boolean             @default(true)
  staffScopes StaffWarehouse[]
  receipts    InboundReceipt[]
  balances    StockBalance[]
  locations   WarehouseLocation[]

  @@map("warehouses")
}

model Staff {
  id                   String             @id @db.Uuid
  loginName            String             @unique @map("login_name")
  displayName          String             @map("display_name")
  passwordHash         String             @map("password_hash")
  enabled              Boolean            @default(true)
  authVersion          Int                @default(0) @map("auth_version")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  roles                StaffRole[]
  warehouses           StaffWarehouse[]
  sessions             StaffSession[]
  auditEvents          AuthAuditEvent[]
  createdReceipts      InboundReceipt[]   @relation("receiptCreator")
  reviewedReceipts     InboundReceipt[]   @relation("receiptReviewer")
  businessAudits       BusinessAudit[]
  stockLedger          StockLedger[]
  inventoryChecks      InventoryCheck[]
  createdCounts        StockCount[]       @relation("countCreator")
  reviewedCounts       StockCount[]       @relation("countReviewer")
  isolations           StockIsolation[]
  createdDispositions  StockDisposition[] @relation("dispositionCreator")
  reviewedDispositions StockDisposition[] @relation("dispositionReviewer")
  createdReversals     ReceiptReversal[]  @relation("reversalCreator")
  reviewedReversals    ReceiptReversal[]  @relation("reversalReviewer")

  @@map("staff")
}

model StaffRole {
  staffId  String @map("staff_id") @db.Uuid
  roleCode String @map("role_code")
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([staffId, roleCode])
  @@map("staff_roles")
}

model StaffWarehouse {
  staffId     String    @map("staff_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([staffId, warehouseId])
  @@index([warehouseId])
  @@map("staff_warehouses")
}

model StaffSession {
  id          String    @id @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  authVersion Int       @map("auth_version")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([staffId, expiresAt])
  @@map("staff_sessions")
}

model StaffLoginThrottle {
  key             String   @id @db.Char(64)
  attemptCount    Int      @map("attempt_count")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)

  @@map("staff_login_throttles")
}

model AuthAuditEvent {
  id        String   @id @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  outcome   String
  requestId String   @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor     Staff?   @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([actorId, createdAt])
  @@map("auth_audit_events")
}

model Category {
  id       String     @id @db.Uuid
  name     String     @db.VarChar(80)
  parentId String?    @map("parent_id") @db.Uuid
  enabled  Boolean    @default(true)
  version  Int        @default(0)
  parent   Category?  @relation("categoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("categoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String   @id @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  status      String   @default("DRAFT") @db.VarChar(16)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  skus        Sku[]

  @@index([categoryId, status, id])
  @@map("products")
}

model Sku {
  id            String         @id @db.Uuid
  productId     String         @map("product_id") @db.Uuid
  code          String         @unique @db.VarChar(64)
  barcode       String?        @unique @db.VarChar(64)
  spec          String         @db.VarChar(100)
  unit          String         @db.VarChar(16)
  priceCents    BigInt         @map("price_cents")
  expiryManaged Boolean        @map("expiry_managed")
  enabled       Boolean        @default(true)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receiptLines  InboundLine[]
  balances      StockBalance[]

  @@index([productId])
  @@map("skus")
}

model InboundReceipt {
  id          String        @id @db.Uuid
  warehouseId String        @map("warehouse_id") @db.Uuid
  sourceRef   String        @map("source_ref") @db.VarChar(100)
  status      String        @default("DRAFT") @db.VarChar(16)
  version     Int           @default(0)
  createdBy   String        @map("created_by") @db.Uuid
  reviewedBy  String?       @map("reviewed_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt  DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  postedAt    DateTime?     @map("posted_at") @db.Timestamptz(3)
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator     Staff         @relation("receiptCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer    Staff?        @relation("receiptReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines       InboundLine[]

  @@unique([id, warehouseId])
  @@index([warehouseId, createdAt, id])
  @@map("inbound_receipts")
}

model InboundLine {
  id            String         @id @db.Uuid
  receiptId     String         @map("receipt_id") @db.Uuid
  warehouseId   String         @map("warehouse_id") @db.Uuid
  skuId         String         @map("sku_id") @db.Uuid
  batchNo       String         @map("batch_no") @db.VarChar(64)
  quantity      Int
  unitCostCents BigInt         @map("unit_cost_cents")
  producedAt    DateTime?      @map("produced_at") @db.Timestamptz(3)
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(3)
  receipt       InboundReceipt @relation(fields: [receiptId, warehouseId], references: [id, warehouseId], onDelete: Restrict, onUpdate: NoAction)
  sku           Sku            @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot           StockLot?

  @@unique([id, warehouseId, skuId])
  @@index([receiptId])
  @@index([skuId])
  @@map("inbound_lines")
}

model StockBalance {
  warehouseId     String           @map("warehouse_id") @db.Uuid
  skuId           String           @map("sku_id") @db.Uuid
  onHand          Int              @default(0) @map("on_hand")
  reserved        Int              @default(0)
  blocked         Int              @default(0)
  safety          Int              @default(0)
  version         Int              @default(0)
  inventoryHold   Boolean          @default(false) @map("inventory_hold")
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sku             Sku              @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lots            StockLot[]
  inventoryChecks InventoryCheck[]
  activeCountId   String?          @map("active_count_id") @db.Uuid
  activeCount     StockCount?      @relation("activeCount", fields: [activeCountId, warehouseId, skuId], references: [id, warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  counts          StockCount[]     @relation("countBalance")

  @@id([warehouseId, skuId])
  @@index([skuId])
  @@map("stock_balances")
}

model StockLot {
  id            String            @id @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  skuId         String            @map("sku_id") @db.Uuid
  receiptLineId String            @unique @map("receipt_line_id") @db.Uuid
  batchNo       String            @map("batch_no") @db.VarChar(64)
  locationCode  String            @default("DEFAULT") @map("location_code") @db.VarChar(32)
  onHand        Int               @map("on_hand")
  reserved      Int               @default(0)
  blocked       Int               @default(0)
  unitCostCents BigInt            @map("unit_cost_cents")
  producedAt    DateTime?         @map("produced_at") @db.Timestamptz(3)
  expiresAt     DateTime?         @map("expires_at") @db.Timestamptz(3)
  receivedAt    DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  balance       StockBalance      @relation(fields: [warehouseId, skuId], references: [warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  receiptLine   InboundLine       @relation(fields: [receiptLineId, warehouseId, skuId], references: [id, warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  ledger        StockLedger[]
  positions     StockPosition[]
  reversals     ReceiptReversal[]

  @@unique([receiptLineId, warehouseId, skuId])
  @@unique([id, warehouseId, skuId])
  @@index([warehouseId, skuId, expiresAt, id])
  @@map("stock_lots")
}

model StockLedger {
  id              String            @id @db.Uuid
  lotId           String            @map("lot_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  skuId           String            @map("sku_id") @db.Uuid
  actionKey       String            @unique @map("action_key") @db.VarChar(128)
  deltaOnHand     Int               @map("delta_on_hand")
  deltaReserved   Int               @default(0) @map("delta_reserved")
  deltaBlocked    Int               @default(0) @map("delta_blocked")
  actorId         String            @map("actor_id") @db.Uuid
  requestId       String            @map("request_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  lot             StockLot          @relation(fields: [lotId, warehouseId, skuId], references: [id, warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  actor           Staff             @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  positionEntries PositionLedger[]
  transfer        StockTransfer?
  isolation       StockIsolation?
  disposition     StockDisposition?
  reversal        ReceiptReversal?

  @@unique([id, warehouseId, skuId, lotId])
  @@index([warehouseId, skuId, createdAt])
  @@map("stock_ledger")
}

model BusinessAudit {
  id          String   @id @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(64)
  reason      String?  @db.VarChar(200)
  resourceId  String   @map("resource_id") @db.Uuid
  warehouseId String?  @map("warehouse_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       Staff    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([resourceId, createdAt])
  @@map("business_audits")
}

model IdempotencyRecord {
  scope       String   @db.VarChar(200)
  keyHash     String   @map("key_hash") @db.Char(64)
  requestHash String   @map("request_hash") @db.Char(64)
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, keyHash])
  @@map("idempotency_records")
}

model WarehouseLocation {
  id          String          @id @db.Uuid
  warehouseId String          @map("warehouse_id") @db.Uuid
  code        String          @db.VarChar(32)
  name        String          @db.VarChar(80)
  enabled     Boolean         @default(true)
  version     Int             @default(0)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  positions   StockPosition[]

  @@unique([warehouseId, code])
  @@unique([id, warehouseId])
  @@map("warehouse_locations")
}

model StockPosition {
  id          String            @id @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  skuId       String            @map("sku_id") @db.Uuid
  lotId       String            @map("lot_id") @db.Uuid
  locationId  String            @map("location_id") @db.Uuid
  onHand      Int               @map("on_hand")
  reserved    Int               @default(0)
  blocked     Int               @default(0)
  version     Int               @default(0)
  lot         StockLot          @relation(fields: [lotId, warehouseId, skuId], references: [id, warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  location    WarehouseLocation @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict, onUpdate: NoAction)
  entries     PositionLedger[]
  outgoing    StockTransfer[]   @relation("transferSource")
  incoming    StockTransfer[]   @relation("transferTarget")
  countLines  StockCountLine[]
  isolations  StockIsolation[]
  reversals   ReceiptReversal[]

  @@unique([lotId, locationId])
  @@unique([id, warehouseId, skuId, lotId])
  @@index([warehouseId, skuId, id])
  @@index([locationId])
  @@map("stock_positions")
}

model PositionLedger {
  id            String        @id @db.Uuid
  positionId    String        @map("position_id") @db.Uuid
  warehouseId   String        @map("warehouse_id") @db.Uuid
  skuId         String        @map("sku_id") @db.Uuid
  lotId         String        @map("lot_id") @db.Uuid
  stockLedgerId String        @map("stock_ledger_id") @db.Uuid
  deltaOnHand   Int           @map("delta_on_hand")
  deltaReserved Int           @map("delta_reserved")
  deltaBlocked  Int           @map("delta_blocked")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  position      StockPosition @relation(fields: [positionId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)
  stockLedger   StockLedger   @relation(fields: [stockLedgerId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([stockLedgerId, positionId])
  @@index([positionId])
  @@map("position_ledger")
}

model StockTransfer {
  id               String        @id @db.Uuid
  warehouseId      String        @map("warehouse_id") @db.Uuid
  skuId            String        @map("sku_id") @db.Uuid
  lotId            String        @map("lot_id") @db.Uuid
  sourcePositionId String        @map("source_position_id") @db.Uuid
  targetPositionId String        @map("target_position_id") @db.Uuid
  quantity         Int
  reason           String        @db.VarChar(200)
  stockLedgerId    String        @unique @map("stock_ledger_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  source           StockPosition @relation("transferSource", fields: [sourcePositionId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)
  target           StockPosition @relation("transferTarget", fields: [targetPositionId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)
  stockLedger      StockLedger   @relation(fields: [stockLedgerId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([stockLedgerId, warehouseId, skuId, lotId])
  @@index([warehouseId, createdAt, id])
  @@map("stock_transfers")
}

model InventoryCheck {
  id          String       @id @db.Uuid
  warehouseId String       @map("warehouse_id") @db.Uuid
  skuId       String       @map("sku_id") @db.Uuid
  actorId     String       @map("actor_id") @db.Uuid
  status      String       @db.VarChar(20)
  issueCount  Int          @map("issue_count")
  issues      Json
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  balance     StockBalance @relation(fields: [warehouseId, skuId], references: [warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  actor       Staff        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([warehouseId, skuId, createdAt])
  @@map("inventory_checks")
}

model StockCount {
  id             String           @id @db.Uuid
  warehouseId    String           @map("warehouse_id") @db.Uuid
  skuId          String           @map("sku_id") @db.Uuid
  status         String           @default("FROZEN") @db.VarChar(16)
  version        Int              @default(0)
  reason         String           @db.VarChar(200)
  createdBy      String           @map("created_by") @db.Uuid
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewReason   String?          @map("review_reason") @db.VarChar(200)
  cancelReason   String?          @map("cancel_reason") @db.VarChar(200)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  postedAt       DateTime?        @map("posted_at") @db.Timestamptz(3)
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  balance        StockBalance     @relation("countBalance", fields: [warehouseId, skuId], references: [warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  activeBalances StockBalance[]   @relation("activeCount")
  creator        Staff            @relation("countCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer       Staff?           @relation("countReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines          StockCountLine[]

  @@unique([id, warehouseId, skuId])
  @@index([warehouseId, skuId, id])
  @@map("stock_counts")
}

model StockCountLine {
  id               String        @id @db.Uuid
  countId          String        @map("count_id") @db.Uuid
  warehouseId      String        @map("warehouse_id") @db.Uuid
  skuId            String        @map("sku_id") @db.Uuid
  lotId            String        @map("lot_id") @db.Uuid
  positionId       String        @map("position_id") @db.Uuid
  snapshotOnHand   Int           @map("snapshot_on_hand")
  snapshotReserved Int           @map("snapshot_reserved")
  snapshotBlocked  Int           @map("snapshot_blocked")
  positionVersion  Int           @map("position_version")
  counted          Int?
  count            StockCount    @relation(fields: [countId, warehouseId, skuId], references: [id, warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  position         StockPosition @relation(fields: [positionId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([countId, positionId])
  @@map("stock_count_lines")
}

model StockIsolation {
  id            String             @id @db.Uuid
  warehouseId   String             @map("warehouse_id") @db.Uuid
  skuId         String             @map("sku_id") @db.Uuid
  lotId         String             @map("lot_id") @db.Uuid
  positionId    String             @map("position_id") @db.Uuid
  quantity      Int
  remaining     Int
  version       Int                @default(0)
  reason        String             @db.VarChar(200)
  createdBy     String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  stockLedgerId String             @unique @map("stock_ledger_id") @db.Uuid
  position      StockPosition      @relation(fields: [positionId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)
  creator       Staff              @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockLedger   StockLedger        @relation(fields: [stockLedgerId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)
  dispositions  StockDisposition[]

  @@unique([id, warehouseId, skuId, lotId, positionId])
  @@unique([stockLedgerId, warehouseId, skuId, lotId])
  @@index([warehouseId, skuId, id])
  @@map("stock_isolations")
}

model StockDisposition {
  id               String         @id @db.Uuid
  warehouseId      String         @map("warehouse_id") @db.Uuid
  skuId            String         @map("sku_id") @db.Uuid
  lotId            String         @map("lot_id") @db.Uuid
  positionId       String         @map("position_id") @db.Uuid
  isolationId      String         @map("isolation_id") @db.Uuid
  kind             String         @db.VarChar(16)
  quantity         Int
  positionVersion  Int            @map("position_version")
  isolationVersion Int            @map("isolation_version")
  status           String         @default("DRAFT") @db.VarChar(16)
  version          Int            @default(0)
  reason           String         @db.VarChar(200)
  reviewReason     String?        @map("review_reason") @db.VarChar(200)
  cancelReason     String?        @map("cancel_reason") @db.VarChar(200)
  physicalEvidence String?        @map("physical_evidence") @db.VarChar(200)
  createdBy        String         @map("created_by") @db.Uuid
  reviewedBy       String?        @map("reviewed_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  postedAt         DateTime?      @map("posted_at") @db.Timestamptz(3)
  cancelledAt      DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  stockLedgerId    String?        @unique @map("stock_ledger_id") @db.Uuid
  isolation        StockIsolation @relation(fields: [isolationId, warehouseId, skuId, lotId, positionId], references: [id, warehouseId, skuId, lotId, positionId], onDelete: Restrict, onUpdate: NoAction)
  creator          Staff          @relation("dispositionCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer         Staff?         @relation("dispositionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockLedger      StockLedger?   @relation(fields: [stockLedgerId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([stockLedgerId, warehouseId, skuId, lotId])
  @@index([warehouseId, skuId, id])
  @@index([isolationId], map: "stock_dispositions_isolation_lookup")
  @@map("stock_dispositions")
}

model ReceiptReversal {
  id               String        @id @db.Uuid
  warehouseId      String        @map("warehouse_id") @db.Uuid
  skuId            String        @map("sku_id") @db.Uuid
  lotId            String        @map("lot_id") @db.Uuid
  positionId       String        @map("position_id") @db.Uuid
  quantity         Int
  positionVersion  Int           @map("position_version")
  status           String        @default("DRAFT") @db.VarChar(16)
  version          Int           @default(0)
  reason           String        @db.VarChar(200)
  reviewReason     String?       @map("review_reason") @db.VarChar(200)
  cancelReason     String?       @map("cancel_reason") @db.VarChar(200)
  physicalEvidence String?       @map("physical_evidence") @db.VarChar(200)
  createdBy        String        @map("created_by") @db.Uuid
  reviewedBy       String?       @map("reviewed_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  postedAt         DateTime?     @map("posted_at") @db.Timestamptz(3)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  stockLedgerId    String?       @unique @map("stock_ledger_id") @db.Uuid
  lot              StockLot      @relation(fields: [lotId, warehouseId, skuId], references: [id, warehouseId, skuId], onDelete: Restrict, onUpdate: NoAction)
  position         StockPosition @relation(fields: [positionId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)
  creator          Staff         @relation("reversalCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer         Staff?        @relation("reversalReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockLedger      StockLedger?  @relation(fields: [stockLedgerId, warehouseId, skuId, lotId], references: [id, warehouseId, skuId, lotId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([stockLedgerId, warehouseId, skuId, lotId])
  @@index([warehouseId, skuId, id])
  @@index([lotId])
  @@map("receipt_reversals")
}
