# Run pnpm setup:local to generate isolated local credentials. Never use production credentials.
POSTGRES_USER=yumi_local
POSTGRES_PASSWORD=
POSTGRES_DB=yumi_dev
POSTGRES_PORT=55432
DATABASE_URL=
TEST_DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3000
NODE_ENV=development
PAYMENT_MODE=disabled
PUBLIC_WAREHOUSE_ID=00000000-0000-4000-8000-000000000002
# Generated locally by setup:local; never place real employee credentials here.
LOCAL_ADMIN_LOGIN=admin.local
LOCAL_ADMIN_PASSWORD=
LOCAL_WAREHOUSE_LOGIN=warehouse.local
LOCAL_WAREHOUSE_PASSWORD=
LOCAL_RIDER_LOGIN=rider.local
LOCAL_RIDER_PASSWORD=
STAFF_SESSION_SECONDS=28800
# Consumer development identities: default off, isolated local database + loopback only.
CONSUMER_DEV_LOGIN_ENABLED=0
CONSUMER_SESSION_SECONDS=28800
STAFF_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3000,http://localhost:3000

# Optional address-at-rest key: 32 random bytes as 64 hex characters. No default.
# Local only: npm run setup:address-key (preserves existing key). Back up alongside DB.
ADDRESS_ENCRYPTION_KEY=

# Development-only real inventory reservations; default off. No payment integration.
# Enabling requires loopback API + isolated local yumi_dev/yumi_test database.
ORDER_DEV_SUBMIT_ENABLED=0
# Technical test reservation TTL, integer 1..900; not a confirmed business payment deadline.
ORDER_DEV_HOLD_SECONDS=900

# Optional non-secret offline payment-readiness metadata. Never enables a provider.
# Leave empty until real deployment values are available. No keys are accepted by the readiness UI.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_NOTIFY_URL=

# Synthetic crypto/close-policy self-tests and isolated durable notification records. Default off; no real credentials/callbacks.
PAYMENT_NOTIFICATION_LAB_ENABLED=0
