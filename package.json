{
  "name": "yumi-retail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "node scripts/docker.mjs compose up -d --wait --wait-timeout 60",
    "db:stop": "node scripts/docker.mjs compose stop",
    "db:init": "node scripts/init-databases.mjs",
    "db:generate": "pnpm --filter @yumi/database generate",
    "db:migrate": "pnpm --filter @yumi/database migrate",
    "db:migrate:test": "node --env-file=.env scripts/migrate-test.mjs",
    "db:seed": "node --env-file=.env --import tsx packages/database/prisma/seed.ts",
    "predb:seed:catalog": "npm run build:server",
    "db:seed:catalog": "node --env-file=.env scripts/seed-catalog.mjs",
    "predev:api": "npm run build:server",
    "dev:api": "node --env-file=.env apps/api/dist/main.js",
    "predev:worker": "npm run build:server",
    "dev:worker": "node --env-file=.env apps/worker/dist/main.js",
    "dev:admin": "pnpm --filter @yumi/admin-web dev",
    "dev:ops": "pnpm --filter @yumi/ops-mobile dev",
    "build:mini": "node scripts/build-mini.mjs local",
    "build:mini:device": "node scripts/build-mini.mjs device",
    "verify:mini:device": "node scripts/verify-mini-device.mjs",
    "test:mini-build": "node tests/mini-build.test.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @yumi/api... --filter @yumi/worker... build",
    "pretest:s0": "npm run build:server",
    "test:s0": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/s0.integration.test.ts",
    "pretest:s1": "npm run build:server",
    "test:s1": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/s1.integration.test.ts",
    "pretest:s2": "npm run build:server",
    "test:s2": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/catalog-inbound.integration.test.ts",
    "pretest:inventory": "npm run build:server",
    "test:inventory": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/inventory-locations.integration.test.ts",
    "pretest:counts": "npm run build:server",
    "test:counts": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/stock-count.integration.test.ts",
    "pretest:dispositions": "npm run build:server",
    "test:dispositions": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/stock-disposition.integration.test.ts",
    "pretest:reversals": "npm run build:server",
    "test:reversals": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/receipt-reversal.integration.test.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:export": "npm run build:server && node --env-file=.env scripts/export-openapi.mjs",
    "test:mini-detail": "node --import tsx tests/mini-detail.test.ts",
    "test:mini-categories": "node --import tsx tests/mini-categories.test.ts",
    "test:mini-browse": "node --import tsx tests/mini-browse.test.ts",
    "verify:mini:api": "node scripts/verify-mini-api.mjs",
    "verify:product-images": "node --env-file=.env scripts/check-product-image-store.mjs",
    "verify:mini": "node scripts/verify-mini-artifacts.mjs"
  },
  "pnpm": {
    "overrides": {
      "terser-webpack-plugin": "5.3.10",
      "schema-utils@^4": "4.3.2"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.72.1",
    "prettier": "3.7.4",
    "pg": "8.23.1",
    "pnpm": "10.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
